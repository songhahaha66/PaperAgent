{
  "name": "paperagent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "format": "prettier --write src/",
    "test:history": "node --experimental-vm-modules tests/workHistory.test.cjs",
    "test:preview": "node --experimental-vm-modules tests/workPreview.test.cjs",
    "test:panels": "node --experimental-vm-modules tests/workPanels.test.cjs && node --experimental-vm-modules tests/workPaneLayout.test.cjs && node --experimental-vm-modules tests/workInteractions.test.cjs",
    "test:workspace": "npm run test:panels && npm run test:preview && npm run test:history && npm run test:research && npm run test:resources && npm run test:theme && npm run test:home && npm run test:messages",
    "test:research": "node --experimental-vm-modules tests/researchEvidence.test.cjs && node --experimental-vm-modules tests/researchProgress.test.cjs && node --experimental-vm-modules tests/paperPipelineCard.test.cjs",
    "test:resources": "node --experimental-vm-modules tests/workResources.test.cjs",
    "test:theme": "node tests/theme.test.cjs",
    "test:home": "node --experimental-vm-modules tests/home.test.cjs",
    "test:messages": "node --experimental-vm-modules tests/jsonChatRenderer.test.cjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@tdesign-vue-next/chat": "^0.5.2",
    "docx-preview": "^0.3.7",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.44",
    "markdown-it": "^14.2.0",
    "markdown-it-katex": "^2.0.3",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "tdesign-icons-vue-next": "^0.4.2",
    "tdesign-vue-next": "^1.18.2",
    "vue": "^3.5.31",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.8.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.16",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vue-tsc": "^3.2.6"
  },
  "overrides": {
    "markdown-it-katex": {
      "katex": "^0.16.0"
    }
  }
}
