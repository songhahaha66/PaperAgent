# 数据库配置
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/paperagent

# JWT配置
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Passkey / WebAuthn（可选。未设置时从请求 Origin 自动推导 rp_id）
# 生产环境建议显式配置；Passkey 需要 HTTPS 或 localhost
# WEBAUTHN_RP_ID=example.com
# WEBAUTHN_RP_NAME=PaperAgent
# WEBAUTHN_ORIGIN=https://example.com
# WEBAUTHN_ORIGINS=https://example.com,https://www.example.com

# 应用配置
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# 数据存储路径配置（可选）
# PA_DATA_PATH=/path/to/pa_data
# 如果不设置，将使用项目根目录下的 pa_data 目录

# 测试用 OpenAI 兼容网关（可选）。未在界面配置模型时，AI/识图会回退到这里。
# Base URL 必须能访问 /v1/chat/completions；只填 host:port 时程序会自动补 /v1。
# PAPERAGENT_API_KEY=
# PAPERAGENT_API_BASE=http://127.0.0.1:30080/v1
# PAPERAGENT_API_MODEL=grok-4.6
# 供应商私有参数（JSON），如 DeepSeek 官方 API 关闭思考模式
# PAPERAGENT_API_EXTRA_BODY={"thinking": {"type": "disabled"}}

# 论文生成流水线（可选，见 ai_system/research/README.md）
# 建模方案需要用户在聊天里确认后再求解
# AI_CONFIRM_MODELS=0
# 求解前试跑几个候选方案（1 表示关闭探索）
# AI_EXPLORE_TOPK=2
# 仅供独立评测命令行 python -m evals 使用；用户连接必须在模型设置中保存个人密钥。
# TYPESAFE_API_KEY=
# TYPESAFE_DEFAULT_MODEL=jev-1.14.0

# 普通聊天自动识别问答、研究、需求变更和继续任务，使用界面中配置的主模型。
# 问答只读取当前工作已有材料，不恢复计算；无需单独配置追问开关。

# LangSmith Agent 追踪（可选）。启用后上传研究状态、模型消息和能力输入/输出。
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=PaperAgent
# 默认美国区；其他区域/自托管请填账号对应的 API endpoint。
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# API key 属于多个工作区时指定：
# LANGSMITH_WORKSPACE_ID=

# Workspace v2: backend files stay in PA_DATA_PATH; sandbox storage is an API-managed execution cache.
# PAPERAGENT_SANDBOX_CONFIG=/path/to/private/client.env
