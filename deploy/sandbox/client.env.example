# Copy to backend/.sandbox.env (ignored). Never commit credentials.
PAPERAGENT_SANDBOX_PROVIDER=opensandbox
PAPERAGENT_SANDBOX_ENDPOINT=http://127.0.0.1:18080
PAPERAGENT_SANDBOX_API_KEY=replace-with-server-key
PAPERAGENT_SANDBOX_IMAGE=paperagent-research:workspace-v2
PAPERAGENT_SANDBOX_CPU=2
PAPERAGENT_SANDBOX_MEMORY=2Gi
PAPERAGENT_SANDBOX_LIFETIME=1800

# REQUIRED: explicitly provision sharing; do not create independent copies.
PAPERAGENT_WORKSPACE_ROOT=/srv/paperagent-shared/files
PAPERAGENT_EVIDENCE_ROOT=/srv/paperagent-shared/evidence
PAPERAGENT_SANDBOX_HOST_WORKSPACE_ROOT=/home/operator/paperagent-sandbox/volumes/files
PAPERAGENT_SANDBOX_HOST_EVIDENCE_ROOT=/home/operator/paperagent-sandbox/volumes/evidence
