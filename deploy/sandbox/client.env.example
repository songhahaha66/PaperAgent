# Copy to backend/.sandbox.env (ignored). Never commit credentials.
PAPERAGENT_SANDBOX_PROVIDER=opensandbox
PAPERAGENT_SANDBOX_ENDPOINT=http://127.0.0.1:18080
PAPERAGENT_SANDBOX_API_KEY=replace-with-server-key
PAPERAGENT_SANDBOX_IMAGE=paperagent-research:opensandbox-1.1.0
PAPERAGENT_SANDBOX_CPU=2
PAPERAGENT_SANDBOX_MEMORY=2Gi
PAPERAGENT_SANDBOX_LIFETIME=1800
