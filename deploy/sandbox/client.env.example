# Copy to backend/.sandbox.env (ignored). Never commit credentials.
PAPERAGENT_SANDBOX_PROVIDER=opensandbox
PAPERAGENT_SANDBOX_ENDPOINT=http://127.0.0.1:18080
PAPERAGENT_SANDBOX_API_KEY=replace-with-server-key
PAPERAGENT_SANDBOX_IMAGE=paperagent-research:workspace-v2
# Lightweight single-host default. Increase explicitly for larger datasets.
PAPERAGENT_SANDBOX_CPU=1
PAPERAGENT_SANDBOX_MEMORY=768Mi
PAPERAGENT_SANDBOX_LIFETIME=1800

# Server-side local persistent cache, not a path on the backend machine.
PAPERAGENT_SANDBOX_HOST_WORKSPACE_ROOT=/home/operator/paperagent-sandbox/volumes/execution-cache
